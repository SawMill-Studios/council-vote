# Site-wide secret that may create sessions. It does not run any one session.
# Set a long random string in Netlify (and in .env.local for `npm run dev`).
# Do not commit a real value. This file is the only env file that belongs in git.
COUNCIL_CREATOR_KEY=replace-with-a-long-random-string

# Optional. Shared venue Wi-Fi is one IP. Defaults are 200 stickies and 400 writes per minute.
COUNCIL_NETWORK_STICKY_CAP=
COUNCIL_NETWORK_RATE_LIMIT=

# CLI only (`npm run create-session`, `list-sessions`, `export-session`).
# The deployed site does not read this. No trailing path.
COUNCIL_BASE_URL=https://your-site.netlify.app
